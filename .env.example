# Frontend environment (Vite)
#
# IMPORTANT: only PUBLIC values belong in committed env files (.env.example,
# .env.production). Every `VITE_`-prefixed var is inlined into the browser
# bundle at build time and is therefore world-readable. Never put server
# secrets (OpenAI keys, JWT secrets, Supabase service-role keys, VAPID private
# key) in a `VITE_` var or in any committed .env file. Server secrets live only
# on Railway / in the local, gitignored `.env`.

# Base URL of the backend API (public)
VITE_API_URL=

# Supabase Auth browser configuration (public project URL + publishable key).
# The legacy public anon key is also accepted as VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth iOS client ID (public), used only by the native iOS sign-in flow.
# Create it in Google Cloud Console as an "iOS" OAuth client for the app's
# bundle ID, then add the same value to Supabase Auth's Google "Client IDs"
# list so signInWithIdToken accepts tokens minted for it. The web flow does not
# use this — it goes through Supabase's hosted redirect and its Web client.
VITE_GOOGLE_IOS_CLIENT_ID=

# Public VAPID key (same value as backend VAPID_PUBLIC_KEY), exposed to the browser
VITE_VAPID_PUBLIC_KEY=

# PostHog analytics (public ingest key + host)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
