PORT=3001
JWT_SECRET=your-super-secret-jwt-key-here

# Public URLs used by the MCP OAuth 2.1 discovery and consent flow.
FRONTEND_URL=http://localhost:5173
MCP_PUBLIC_URL=http://localhost:3001/mcp
MCP_OAUTH_ISSUER=http://localhost:3001
# Use a separate high-entropy secret in production. JWT_SECRET is the fallback.
MCP_OAUTH_JWT_SECRET=
# Comma-separated HTTPS origins allowed to serve CIMD client metadata.
MCP_OAUTH_CLIENT_ID_ORIGINS=https://chatgpt.com,https://www.chatgpt.com

# Web Push (VAPID) — generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:lermanori@gmail.com
