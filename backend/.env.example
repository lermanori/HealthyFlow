PORT=3001
JWT_SECRET=your-super-secret-jwt-key-here

# Public URLs used by the MCP OAuth 2.1 discovery and consent flow.
FRONTEND_URL=http://localhost:5173
MCP_PUBLIC_URL=http://localhost:3001/mcp
MCP_OAUTH_ISSUER=http://localhost:3001
# Use a separate high-entropy secret in production. JWT_SECRET is the fallback.
MCP_OAUTH_JWT_SECRET=
# Comma-separated HTTPS origins allowed to serve CIMD client metadata.
MCP_OAUTH_CLIENT_ID_ORIGINS=https://chatgpt.com,https://www.chatgpt.com

# Web Push (VAPID) — generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:lermanori@gmail.com

# Apple Push Notification service. Store the .p8 key with literal `\n`
# separators when the environment provider only accepts single-line values.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=app.healthyflow.mobile
APNS_ENVIRONMENT=production

# Native iOS minimum-version gate. Leave disabled until the App Store listing
# exists and IOS_APP_STORE_URL contains its final apps.apple.com URL.
IOS_VERSION_GATE_ENABLED=false
IOS_MINIMUM_VERSION=1.0
IOS_LATEST_VERSION=1.0
IOS_APP_STORE_URL=
IOS_UPDATE_MESSAGE=A newer version of HealthyFlow is required to continue.
