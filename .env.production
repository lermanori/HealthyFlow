# Cloud replication for accounts that already hold the entitlement (2026-09-11).
#
# This is not an acquisition path: no user can obtain Cloud in v1 (ADR-0019), and
# the only identity holding it is the founder's legacy exception. The flag only
# lets the client attempt an exchange — the entitlement is enforced server-side
# by `CloudAccess.require` on every POST /sync, which answers 403
# `cloud_not_active` for everyone else. The Local day remains the source
# (ADR-0011); the server is a replica.
VITE_CLOUD_SYNC_ENABLED=true
