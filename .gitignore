# Dependencies
node_modules

# Environment
.env
.env.local
.env.*.local
.env.prod-backup.*

# Build output
dist
backend/dist

# Local databases (use Supabase in production)
*.db
*.db-journal

# Logs
*.log
ngrok.log
11labs-gen/

# Netlify
.netlify

# Skills installer drop (managed by `npx skills add`)
.agents
skills-lock.json

# Claude Code: track the shared harness, ignore per-dev and session state.
# .claude/skills/ is committed on purpose — CLAUDE.md documents those skills,
# so every clone and cloud agent must have them.
.claude/*
!.claude/skills/
!.claude/settings.json

# OS / editor
.DS_Store
.vscode
.idea

# E2E test auth state (sensitive, varies per dev)
tests/e2e/.auth/

# Playwright run artifacts
test-results/
e2e-results.json
e2e-errors.txt
.board-harness/

# Generated documentation artifacts — `npm --prefix backend run inventory:html` rebuilds these
docs/generated/

# Throwaway notes — declared untracked in CLAUDE.md
.scratch/
