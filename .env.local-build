# Public Vite configuration for a production-shaped bundle using the local API.
# Authentication values may still come from the gitignored .env file.
VITE_API_URL=http://localhost:3001/api

# Cloud replication, matching .env.production so the local build can exercise the
# same path. The entitlement is still enforced server-side by CloudAccess.require
# on every POST /sync; this only lets the client attempt an exchange.
VITE_CLOUD_SYNC_ENABLED=true
